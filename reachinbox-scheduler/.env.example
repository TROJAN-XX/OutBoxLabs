# ==========================================
# ReachInbox Email Scheduler Environment Config
# ==========================================

# Database (PostgreSQL)
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=reachinbox_secret
POSTGRES_DB=reachinbox_db
DATABASE_URL=postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox_db

# Redis
REDIS_URL=redis://localhost:6379

# Backend Server
PORT=5000
NODE_ENV=development
JWT_SECRET=change-this-to-a-strong-random-secret-key-in-production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# Google OAuth (Optional for Demo mode; Required for Google Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ethereal SMTP (Optional: automatically provisioned if left empty)
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# Worker & Queue Settings
WORKER_CONCURRENCY=5
MAX_EMAILS_PER_HOUR=100
MIN_EMAIL_DELAY_MS=2000
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_BACKOFF_MS=5000

# Frontend Configuration
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=
